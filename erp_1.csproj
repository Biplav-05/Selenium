<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!-- Exclude the SeleniumTests sub-project from this build -->
  <ItemGroup>
    <Compile Remove="SeleniumTests/**" />
    <Content Remove="SeleniumTests/**" />
    <EmbeddedResource Remove="SeleniumTests/**" />
    <None Remove="SeleniumTests/**" />
  </ItemGroup>

</Project>
